<odoo>
    <record id="view_fm_expiry_list" model="ir.ui.view">
        <field name="name">fm.expiry.record.list</field>
        <field name="model">fm.expiry.record</field>
        <field name="arch" type="xml">
            <list string="Theo dõi hạn sử dụng" decoration-danger="alert_level == 'expired'" decoration-warning="alert_level == '7'">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="expiry_date"/>
                <field name="quantity_observed"/>
                <field name="days_left"/>
                <field name="alert_level"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_fm_expiry_form" model="ir.ui.view">
        <field name="name">fm.expiry.record.form</field>
        <field name="model">fm.expiry.record</field>
        <field name="arch" type="xml">
            <form string="Theo dõi hạn sử dụng">
                <header>
                    <button name="action_mark_handled" type="object" string="Đánh dấu đã xử lý"
                            groups="stock.group_stock_manager" invisible="state == 'handled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,handled"/>
                </header>
                <sheet><group>
                    <field name="product_id"/>
                    <field name="location_id"/>
                    <field name="expiry_date"/>
                    <field name="quantity_observed"/>
                    <field name="days_left" readonly="1"/>
                    <field name="alert_level" readonly="1"/>
                    <field name="note"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_fm_expiry" model="ir.actions.act_window">
        <field name="name">Theo dõi HSD 7/15/30</field>
        <field name="res_model">fm.expiry.record</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fm_expiry" name="Theo dõi HSD 7/15/30" parent="menu_fm_root"
              action="action_fm_expiry" sequence="40"/>

    <record id="view_fm_issue_list" model="ir.ui.view">
        <field name="name">fm.issue.record.list</field>
        <field name="model">fm.issue.record</field>
        <field name="arch" type="xml">
            <list string="Báo cáo ngoại lệ kho">
                <field name="name"/>
                <field name="issue_type"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="quantity"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_fm_issue_form" model="ir.ui.view">
        <field name="name">fm.issue.record.form</field>
        <field name="model">fm.issue.record</field>
        <field name="arch" type="xml">
            <form string="Báo cáo ngoại lệ kho">
                <header>
                    <button name="action_review" type="object" string="Tiếp nhận xử lý"
                            groups="stock.group_stock_manager" invisible="state != 'open'"/>
                    <button name="action_close" type="object" string="Đóng vụ việc"
                            groups="stock.group_stock_manager" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,review,closed"/>
                </header>
                <sheet><group>
                    <field name="name"/>
                    <field name="issue_type"/>
                    <field name="product_id"/>
                    <field name="location_id"/>
                    <field name="quantity"/>
                    <field name="note"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_fm_issue" model="ir.actions.act_window">
        <field name="name">Hàng lỗi / chênh lệch / hàng hủy</field>
        <field name="res_model">fm.issue.record</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fm_issue" name="Báo cáo hàng lỗi/chênh lệch"
              parent="menu_fm_root" action="action_fm_issue" sequence="50"/>
</odoo>
