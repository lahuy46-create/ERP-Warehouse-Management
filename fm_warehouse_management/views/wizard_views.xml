<odoo>

    <!-- ================================================== -->
    <!-- 1. NHAP DU LIEU BAN HANG CSV                        -->
    <!-- ================================================== -->

    <record
        id="view_fm_sales_import_wizard_form"
        model="ir.ui.view">

        <field name="name">
            fm.sales.import.wizard.form
        </field>

        <field name="model">
            fm.sales.import.wizard
        </field>

        <field name="arch" type="xml">

            <form string="Nhập dữ liệu bán hàng FamilyMart">

                <sheet>

                    <group string="Tệp dữ liệu bán hàng">

                        <field
                            name="csv_file"
                            filename="filename"
                            required="1"
                        />

                        <field
                            name="filename"
                            invisible="1"
                        />

                    </group>

                    <group string="Kỳ bán hàng">

                        <field
                            name="period_start"
                            required="1"
                        />

                        <field
                            name="period_end"
                            required="1"
                        />

                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_import"
                        type="object"
                        string="Đọc và đối chiếu CSV"
                        class="btn-primary"
                    />

                    <button
                        string="Hủy"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>


    <!-- Action nhap CSV -->

    <record
        id="action_fm_sales_import_wizard"
        model="ir.actions.act_window">

        <field name="name">
            Nhập dữ liệu bán hàng
        </field>

        <field name="res_model">
            fm.sales.import.wizard
        </field>

        <field name="view_mode">
            form
        </field>

        <field
            name="view_id"
            ref="view_fm_sales_import_wizard_form"
        />

        <field name="target">
            new
        </field>

    </record>


    <!-- Gan action mac dinh cho ung dung FamilyMart -->

    <menuitem
        id="menu_fm_root"
        name="FamilyMart"
        action="action_fm_sales_import_wizard"
        sequence="20"
        groups="base.group_user"
    />


    <!-- Menu nhap du lieu ban hang: uu tien so 1 -->

    <menuitem
        id="menu_fm_sales_import"
        name="Nhập CSV bán hàng (3 cột)"
        parent="menu_fm_root"
        action="action_fm_sales_import_wizard"
        sequence="1"
        groups="stock.group_stock_manager"
    />


    <!-- ================================================== -->
    <!-- 2. TRA CUU TON KHO THEO VI TRI                     -->
    <!-- ================================================== -->

    <record
        id="view_fm_stock_lookup_form"
        model="ir.ui.view">

        <field name="name">
            fm.stock.lookup.wizard.form
        </field>

        <field name="model">
            fm.stock.lookup.wizard
        </field>

        <field name="arch" type="xml">

            <form string="Tra cứu tồn kho theo vị trí">

                <sheet>

                    <group string="Thông tin tra cứu">

                        <field name="product_id"/>

                        <field name="location_id"/>

                    </group>

                    <group string="Kết quả tồn kho">

                        <field
                            name="qty_on_hand"
                            readonly="1"
                        />

                        <field
                            name="qty_available"
                            readonly="1"
                        />

                    </group>

                </sheet>

                <footer>

                    <button
                        string="Đóng"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>


    <!-- Action tra cuu ton kho -->

    <record
        id="action_fm_stock_lookup"
        model="ir.actions.act_window">

        <field name="name">
            Tra cứu tồn kho theo vị trí
        </field>

        <field name="res_model">
            fm.stock.lookup.wizard
        </field>

        <field name="view_mode">
            form
        </field>

        <field
            name="view_id"
            ref="view_fm_stock_lookup_form"
        />

        <field name="target">
            new
        </field>

    </record>


    <!-- Menu tra cuu ton kho -->

    <menuitem
        id="menu_fm_stock_lookup"
        name="Tra cứu tồn kho theo kệ"
        parent="menu_fm_root"
        action="action_fm_stock_lookup"
        sequence="30"
        groups="base.group_user"
    />


    <!-- ================================================== -->
    <!-- 3. XUAT DU LIEU CHO POWER BI                       -->
    <!-- ================================================== -->

    <record
        id="view_fm_bi_export_wizard_form"
        model="ir.ui.view">

        <field name="name">
            fm.bi.export.wizard.form
        </field>

        <field name="model">
            fm.bi.export.wizard
        </field>

        <field name="arch" type="xml">

            <form string="Xuất dữ liệu Power BI">

                <sheet>

                    <group string="Dữ liệu xuất báo cáo">

                        <field
                            name="file_data"
                            filename="file_name"
                            readonly="1"
                        />

                        <field
                            name="file_name"
                            invisible="1"
                        />

                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_export"
                        type="object"
                        string="Tạo ZIP gồm 5 file CSV"
                        class="btn-primary"
                    />

                    <button
                        string="Đóng"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>


    <!-- Action xuat du lieu Power BI -->

    <record
        id="action_fm_bi_export_wizard"
        model="ir.actions.act_window">

        <field name="name">
            Xuất dữ liệu Power BI
        </field>

        <field name="res_model">
            fm.bi.export.wizard
        </field>

        <field name="view_mode">
            form
        </field>

        <field
            name="view_id"
            ref="view_fm_bi_export_wizard_form"
        />

        <field name="target">
            new
        </field>

    </record>


    <!-- Menu xuat Power BI -->

    <menuitem
        id="menu_fm_bi_export"
        name="Xuất CSV cho Power BI"
        parent="menu_fm_root"
        action="action_fm_bi_export_wizard"
        sequence="80"
        groups="stock.group_stock_manager"
    />

</odoo>
